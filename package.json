{
  "name": "newsletter-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "db:new": "node scripts/new-migration.mjs",
    "db:reset": "supabase db reset",
    "db:push": "dotenv -e .env.production.local -- supabase db push",
    "db:types": "dotenv -e .env.production.local -- supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "db:types:local": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
    "migration-lint": "node scripts/migration-lint.mjs",
    "create-admin": "dotenv -e .env.production.local -- tsx scripts/create-admin.ts",
    "invite-link": "dotenv -e .env.production.local -- tsx scripts/invite-link.ts",
    "seed-dev": "dotenv -e .env.local -- tsx scripts/seed-dev.ts",
    "build:cf": "dotenv -e .env.production.local -- sh -c 'SUPABASE_SECRET_KEY= SUPABASE_DB_PASSWORD= opennextjs-cloudflare build'",
    "deploy": "pnpm run build:cf && node scripts/check-bundle-secrets.mjs && dotenv -e .env.production.local -- opennextjs-cloudflare deploy",
    "preview": "pnpm run build:cf && dotenv -e .env.production.local -- opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "prepare": "husky",
    "check:publishable": "node scripts/check-publishable.mjs",
    "check:publishable:build": "node scripts/build-publish-denylist.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.545.0",
    "modern-screenshot": "^4.7.0",
    "next": "16.2.12",
    "pptxgenjs": "^4.0.1",
    "radix-ui": "^1.6.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.68.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "supabase": "^2.55.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.108.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,md,json,css}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "supabase",
      "workerd"
    ]
  }
}
